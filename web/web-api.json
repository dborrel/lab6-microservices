{
  "openapi": "3.0.1",
  "info": {
    "title": "Web Service API",
    "description": "Web frontend API for the accounts microservice",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local server"
    }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "operationId": "goHome",
        "summary": "Account home page",
        "responses": {
          "200": {
            "description": "Home page HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountNumber}": {
      "get": {
        "operationId": "byNumber",
        "summary": "View account by number",
        "parameters": [
          {
            "name": "accountNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/owner/{text}": {
      "get": {
        "operationId": "ownerSearch",
        "summary": "Search by owner name",
        "parameters": [
          {
            "name": "text",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/search": {
      "get": {
        "operationId": "searchForm",
        "summary": "Display search form",
        "responses": {
          "200": {
            "description": "Search form HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/dosearch": {
      "get": {
        "operationId": "doSearch",
        "summary": "Execute search",
        "parameters": [
          {
            "name": "accountNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchText",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}